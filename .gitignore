# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Ruff
.ruff_cache/

# Logs
*.log
curator_debug.log

# Typst build artifacts
*.typst.pdf

# Profile output (per-job curations, plus cover-letter failure-recovery partials)
profiles/**
!profiles/.gitkeep

# Testing (may contain resume content or employer references)
testing/notes.md
testing/jds/
# testing/results/ holds eval JSONs, partial recovery files, and full
# rendered profiles from real-JD test runs (JD text, curated YAML, PDFs,
# cover letter prose). All real-candidate / real-employer content; per
# CLAUDE.md Sensitive Content section it must never land in the public
# repo. The previous narrow patterns only caught top-level *.json /
# *.stdout / *.stderr; broadened 2026-05-09 to ignore the entire tree
# after a `git add -A` from the Haiku eval staged real cover letters.
testing/results/

# Config overrides (user-specific)
config.toml

# Claude Code agent local state (per-machine; not synced), EXCEPT committed
# slash commands under .claude/commands/ which are shared and version-controlled.
.claude/*
!.claude/commands/
