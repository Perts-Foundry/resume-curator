# Required: Anthropic API key (https://console.anthropic.com/)
CURATOR_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required: Explicitly authorize API spending (safety guard against surprise charges)
# Set to true when you are ready to make API calls
CURATOR_ALLOW_API_SPEND=false

# Required for curate/static: path to your portfolio source directory
# CURATOR_PORTFOLIO_PATH=../professional-portfolio-source

# Optional overrides (uncomment to change defaults)
# CURATOR_MODEL=claude-sonnet-4-6     # alias; pin to a snapshot ID for reproducibility
# CURATOR_MAX_TOKENS=4096
# CURATOR_MAX_PAGES=2                  # target page count, 1..5; pass --pages to override per run
# CURATOR_CACHE_TTL=1h                 # prompt-cache TTL: 5m or 1h
# CURATOR_OUTPUT_DIR=profiles
# CURATOR_BACKEND=api                  # curate transport: api (billed per token) or
#                                      #   claude-code (headless `claude -p`, billed to
#                                      #   your Claude subscription). This is the one
#                                      #   setting that changes which product bills you.
# CURATOR_JUDGE_BACKEND=api            # same values, for the Tier 2 eval judge
# CURATOR_HEADLESS_TIMEOUT=600         # claude-code subprocess timeout in seconds, 60..3600
